        "name": "Средний зимний AQI",
        "unit": "индекс AQI",
        "formula": "E2 = clip((200 − X) / 150 × 100), 0 при AQI ≥ 200",
        "raw_per_score_point": -1.5
      },
      "analog": "аналог индекса AQI (PM2.5)"
    },
    {
      "code": "S1",
      "direction": "social",
      "name": "Школы и детсады",
      "meaning": "100 = 100% нормативной потребности, без 2-й смены",
      "weight": 0.11,
      "raw": {
        "name": "Обеспеченность местами в школах и детсадах",
        "unit": "% от норматива",
        "formula": "S1 = clip((X − 50) × 2), 0 при ≤50%",
        "raw_per_score_point": 0.5
      },
      "analog": "аналог нормативов обеспеченности"
    },
    {
      "code": "S2",
      "direction": "social",
      "name": "Поликлиники и первичная медпомощь",
      "meaning": "100 = норматив на жителя выполнен полностью",
      "weight": 0.11,
      "raw": {
        "name": "Обеспеченность мощностью ПМСП",
        "unit": "% от норматива посещений в смену",
        "formula": "S2 = clip((X − 50) × 2), 0 при ≤50%",
        "raw_per_score_point": 0.5
      },
      "analog": "аналог норматива мощности ПМСП"
    },
    {
      "code": "B1",
      "direction": "safety",
      "name": "Безопасность улиц",
      "meaning": "100 = освещение и камеры везде, минимум происшествий",
      "weight": 0.09,
      "raw": {
        "name": "Улицы с освещением и камерами",
