  "rules": {
    "budget": 100,
    "decisions_exact": 5,
    "no_repeats": true,
    "max_per_direction": 2,
    "horizon_quarters": 8,
    "lag_factor": "(8 - lag) / 8",
    "critical_threshold": 40,
    "critical_penalty": 1.0,
    "score_formula": "0.7 * D_avg + 0.3 * min(D_d) - 1.0 * N_crit",
    "leftover_budget": "не сгорает и не даёт бонуса; в режиме событий используется как резерв",
    "rounding": "считать во float, округлять до 2 знаков только при выводе"
  },
  "directions": {
    "transport": "Транспорт",
    "ecology": "Экология",
